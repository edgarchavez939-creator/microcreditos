APP_NAME="Microcreditos"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://TU-SERVICIO.onrender.com
APP_TIMEZONE=America/Bogota

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- PostgreSQL: pega aquí la cadena de conexión de Neon ---
# Ejemplo Neon: postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/microcreditos?sslmode=require
# --- MULTI-EMPRESA · REQUISITOS DE LA CONEXIÓN ---
# 1) Usa el endpoint DIRECTO de Neon (sin "-pooler"). El agrupador en modo
#    transacción puede repartir una conexión entre peticiones y filtrar el
#    contexto de empresa de un cliente a otro.
# 2) El rol de conexión NO debe ser superusuario ni tener BYPASSRLS: esos roles
#    ignoran el aislamiento y una empresa podría ver los datos de otra.
#    Verificar con:  SELECT rolsuper, rolbypassrls FROM pg_roles WHERE rolname = current_user;
DATABASE_URL=
DB_CONNECTION=pgsql
DB_SSLMODE=require

# --- Modo prueba: sin Redis ---
CACHE_STORE=database
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

# --- JWT (genera con: php artisan jwt:secret) ---
JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=20160

# --- CORS: dominio del frontend en Vercel ---
CORS_ALLOWED_ORIGINS=https://TU-APP.vercel.app

# --- S3 (opcional en pruebas; para subir documentos) ---
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

GOOGLE_MAPS_API_KEY=
THROTTLE_LOGIN=5,1

# --- Seguimiento en vivo (mapa territorial) ---
# Días de historial GPS que se conservan (el resto se depura a diario).
UBICACIONES_DIAS_RETENCION=7
# Intervalo mínimo entre puntos del mismo empleado (segundos).
UBICACIONES_INTERVALO_MIN=45
# Anti-ruido de reposo: metros mínimos de desplazamiento y ventana (segundos).
UBICACIONES_MOVIMIENTO_MIN_M=25
UBICACIONES_VENTANA_REPOSO=300
# Máximo de puntos enviados al dibujar el recorrido del día.
UBICACIONES_MAX_PUNTOS=120

# --- Ingreso con Google ---
# ID de cliente OAuth (Google Cloud Console > Credenciales > ID de cliente de OAuth 2.0,
# tipo "Aplicación web"). No es secreto: viaja al navegador. Si se deja vacío, el botón
# de Google no aparece y la aplicación funciona solo con contraseña.
GOOGLE_CLIENT_ID=

# --- ALTA DEL PRIMER ADMINISTRADOR (temporal) ---
# Se usa una sola vez, cuando no hay consola disponible en el servidor.
# Al arrancar, si estas variables existen, se crea el usuario y su contraseña
# aparece en el registro del despliegue. Cópiala, BORRA estas variables y
# vuelve a desplegar: no deben quedar configuradas de forma permanente.
CREAR_ADMIN_EMAIL=
CREAR_ADMIN_NOMBRE=
CREAR_ADMIN_EMPRESA=1
# "true" crea el Administrador Global de KRYPTA (sin empresa)
CREAR_ADMIN_GLOBAL=
